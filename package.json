{
  "name": "xrp-cosy",
  "version": "0.6.0",
  "private": true,
  "description": "xrp-cosy — qwenwork / qoder 双通道的 xrl-router 插件：仅支持自包含网页 OAuth 登录的 Cosy 签名桥接",
  "scripts": {
    "log-in": "tsx scripts/log-in.ts",
    "serve": "tsx src/index.ts",
    "log-in:qoder": "tsx scripts/log-in-qoder.ts",
    "serve:qoder": "tsx src/qoderIndex.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "dotenv": "^16.3.1",
    "hono": "^4.7.4",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  }
}
